IAGIS_ACCESS_BROKER_HOST=127.0.0.1
IAGIS_ACCESS_BROKER_PORT=8092
IAGIS_ACCESS_BROKER_TOKEN=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
IAGIS_ACCESS_ALLOWED_EMAIL_DOMAINS=empresa.com.br

# Modo recomendado: grupos Entra atribuídos à aplicação e sincronizados por SCIM.
# Liste todos os grupos que concedem acesso; a revogação remove o usuário de todos eles.
IAGIS_ACCESS_CLAUDE_MODE=group
IAGIS_ACCESS_CLAUDE_GROUP_IDS=
IAGIS_ACCESS_CHATGPT_MODE=group
IAGIS_ACCESS_CHATGPT_GROUP_IDS=

# Alternativa sem SCIM: atribuição direta à Enterprise Application no Entra.
# Ela controla login, mas não cria/remove assento no SaaS.
# IAGIS_ACCESS_CLAUDE_MODE=app_role
# IAGIS_ACCESS_CLAUDE_SERVICE_PRINCIPAL_ID=
# IAGIS_ACCESS_CLAUDE_APP_ROLE_ID=00000000-0000-0000-0000-000000000000
