GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
# Opcional: utilizado somente quando AI_PROVIDER=openai
OPENAI_API_KEY=
IAGIS_MENTION=@IAgis
IAGIS_DRY_RUN=true
IAGIS_POLL_INTERVAL=60
IAGIS_DATABASE_PATH=/data/iagis.db
# Lista separada por vírgulas; obrigatória para o worker
IAGIS_ALLOWED_ENTITY_IDS=
# Lista de vereditos autorizados para publicação automática
IAGIS_AUTO_PUBLISH_VERDICTS=HOMOLOGADO,HOMOLOGADO_COM_RESTRICOES
# ID do usuário IAgis no GLPI, usado para prevenção de loop
IAGIS_GLPI_USER_ID=
# Entidade executada pelo serviço Docker (deve também estar na allowlist)
IAGIS_ENTITY_ID=
