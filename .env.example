GLPI_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=
AI_PROVIDER=ollama
AI_MODEL=qwen3:4b-instruct-2507-q4_K_M
IAGIS_MODE=suggestion
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=120
IAGIS_MAX_ATTEMPTS=3
IAGIS_RETRY_DELAY=300
IAGIS_ADMIN_USER=iagis
IAGIS_ADMIN_PASSWORD=
IAGIS_ADMIN_HOST=127.0.0.1
IAGIS_ADMIN_PORT=8090
GEMINI_API_KEY=
# Opcional: utilizado somente quando AI_PROVIDER=openai
OPENAI_API_KEY=
IAGIS_MENTION=@IAgis
IAGIS_DRY_RUN=true
IAGIS_POLL_INTERVAL=60
IAGIS_GLPI_INITIAL_LOOKBACK_HOURS=24
IAGIS_GLPI_POLL_OVERLAP_SECONDS=120
IAGIS_DATABASE_PATH=/data/iagis.db
# Lista separada por vírgulas; obrigatória para o worker
IAGIS_ALLOWED_ENTITY_IDS=
# Legado de governança; não controla respostas do modo suggestion
IAGIS_AUTO_PUBLISH_VERDICTS=
# ID do usuário IAgis no GLPI, usado para prevenção de loop
IAGIS_GLPI_USER_ID=
# Entidade executada pelo serviço Docker (deve também estar na allowlist)
IAGIS_ENTITY_ID=
# Gestão OpenVPN: só habilite com o broker local e token aleatório de 32+ caracteres
IAGIS_VPN_ENABLED=false
IAGIS_VPN_BROKER_URL=http://127.0.0.1:8091
IAGIS_VPN_BROKER_TOKEN=
IAGIS_VPN_ACTION_MIN_CONFIDENCE=0.80
IAGIS_VPN_BROKER_PORT=8091
IAGIS_VPN_REMOTE_HOST=
IAGIS_VPN_REMOTE_PORT=1194
IAGIS_OPENVPN_ROOT=/home/agis/openvpn-wcar
IAGIS_VPN_BROKER_UID=1000
IAGIS_VPN_BROKER_GID=1000
